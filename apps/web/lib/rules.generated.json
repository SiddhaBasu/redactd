   "pattern": "\\bhttps?://[^\\s<>\\\"')]+|\\bwww\\.[^\\s<>\\\"')]+",
   "flags": "",
   "validator": "personal_url",
   "why": "URL pattern"
  },
  {
   "id": "ipv4",
   "type": "NETWORK",
   "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b",
   "flags": "",
   "validator": null,
   "why": "IPv4 address pattern"
  },
  {
   "id": "ipv6",
   "type": "NETWORK",
   "pattern": "\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\b|\\b(?:[0-9a-fA-F]{1,4}:){1,7}:(?:[0-9a-fA-F]{1,4}:?){0,6}[0-9a-fA-F]{0,4}\\b",
   "flags": "",
   "validator": null,
   "why": "IPv6 address pattern"
  },
  {
   "id": "mac",
   "type": "NETWORK",
   "pattern": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b",
   "flags": "",
   "validator": null,
   "why": "MAC address pattern"
  },
  {
   "id": "iban",
   "type": "FIN_ID",
   "pattern": "\\b[A-Za-z]{2}\\d{2}(?:(?:[ \\-]{1,2}|\\n)?[A-Za-z0-9]{1,8}){2,16}",
   "flags": "",
   "validator": "iban_prefix",
   "why": "IBAN with valid mod-97 checksum"
  },
  {
   "id": "masked_ssn",
   "type": "GOV_ID",
   "pattern": "(?<![\\w*#\\u2022])[*xX#\\u2022]{3}-[*xX#\\u2022]{2}-\\d{4}\\b",
   "flags": "",
   "validator": null,
   "why": "masked social security number (last 4 visible)"
  },
  {
   "id": "masked_iban",
   "type": "FIN_ID",
   "pattern": "\\b[A-Z]{2}\\d{2}(?:[ \\-]?[A-Z0-9*\\u2022]{4}){2,7}(?:[ \\-]?[A-Z0-9]{1,4})?(?![\\w*])",
   "flags": "",
   "validator": "masked_iban",
   "why": "partially masked IBAN"
  },
  {
   "id": "masked_card",
   "type": "FIN_ID",
   "pattern": "(?<![\\w*#\\u2022])[*xX#\\u2022]{2,19}(?:[ \\-][*xX#\\u2022]{2,6}){0,4}[ \\-]?\\d{4}\\b",
   "flags": "",
   "validator": null,
   "why": "masked card or account number (last 4 visible)"
  },
  {
   "id": "masked_last4",
   "type": "FIN_ID",
   "pattern": "(?<!year )(?<!period )(?<!quarter )(?<!month )(?<!week )(?<!term )(?:ending(?: in| with)?|ends in|last (?:four|4)(?: digits)?(?: of [a-z ]{1,30}?)?(?: are| is)?)[: ]\\s?#?(\\d{4})\\b(?![.,]\\d)",
   "flags": "i",
   "validator": null,
   "why": "last four digits after 'ending' / 'last four'"
  },
  {
   "id": "card",
   "type": "FIN_ID",
   "pattern": "\\b(?:\\d[ -]?){12,18}\\d\\b",
   "flags": "",
   "validator": "luhn",
   "why": "card number with valid Luhn checksum"
  },
  {
   "id": "aba",
   "type": "FIN_ID",
   "pattern": "\\b\\d{9}\\b",
   "flags": "",
   "validator": "aba",
   "why": "US routing number with valid ABA checksum"
  },
  {
   "id": "bic",
   "type": "FIN_ID",
   "pattern": "\\b[A-Z]{4}(?:US|GB|DE|FR|CH|IT|ES|NL|CA|AU|JP|SG|HK|IN|BE|IE|LU|SE|NO|DK|AT|PL|BR|MX|CN)[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
   "flags": "",
   "validator": null,
   "why": "SWIFT/BIC code pattern"
  },
  {
